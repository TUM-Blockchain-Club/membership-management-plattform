NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Local-only auth bypass for reproducible development and performance testing.
# Only works on localhost/127.0.0.1.
DEV_AUTH_BYPASS=false
DEV_AUTH_BYPASS_MEMBER_ID=0
DEV_AUTH_BYPASS_SPECIAL_ACCESS=false

# Optional local performance diagnostics.
NEXT_PUBLIC_LOG_WEB_VITALS=false
NEXT_PUBLIC_MEMBERS_PERF_PROBE=false
NEXT_PUBLIC_MEMBERS_OVERSCAN=6
NEXT_PUBLIC_DASHBOARD_BACKGROUND_ANIMATION=false
PERF_LOG_SERVER=false

# Newsletter / Mailgun (server-side only)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=newsletter.tum-blockchain.com
MAILGUN_REGION=eu
