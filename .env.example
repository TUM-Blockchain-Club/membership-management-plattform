# Supabase client access. Required for normal app operation.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Personal preview only. Uses fake Coffee Chats data and skips Supabase auth.
# Never enable this on the production platform deployment.
NEXT_PUBLIC_COFFEE_CHATS_DEMO=false

# Supabase server/admin access.
# Required for NFT previews, guarded server-side uploads, and maintenance scripts.
SUPABASE_SERVICE_ROLE_KEY=

# Optional direct Postgres connection for SQL migration runners or ad-hoc database tooling.
DATABASE_URL=

# Local-only auth bypass for reproducible development and performance testing.
# Only works on localhost/127.0.0.1.
DEV_AUTH_BYPASS=false
DEV_AUTH_BYPASS_MEMBER_ID=0
DEV_AUTH_BYPASS_SPECIAL_ACCESS=false

# Optional local performance diagnostics for the dashboard and /members page.
NEXT_PUBLIC_LOG_WEB_VITALS=false
NEXT_PUBLIC_MEMBERS_PERF_PROBE=false
NEXT_PUBLIC_MEMBERS_OVERSCAN=6
NEXT_PUBLIC_DASHBOARD_BACKGROUND_ANIMATION=false
PERF_LOG_SERVER=false

# Optional benchmark script tuning.
BENCH_URL=http://127.0.0.1:3000/members
BENCH_ITERATIONS=8
BENCH_WARMUPS=2
BENCH_SCROLL_STEPS=24
BENCH_SCROLL_STEP_PX=520
BENCH_SCROLL_DELAY_MS=80
BENCH_POST_LOAD_WAIT_MS=3000
BENCH_REPORT_DIR=reports/performance
BENCH_TRACE=true

# NFT minting configuration.
# Required only when using the NFT approval mint action.
# If omitted locally, lib/server/contractEnv.ts also checks ../contracts/.env.
POLYGON_RPC_URL=
NFT_CONTRACT_ADDRESS=
DEPLOYER_WALLET_PRIVATE_KEY=
DEPLOYER_WALLET_PUBLIC_KEY=
CHAIN_ID=137
NFT_MINT_GAS_LIMIT=600000
MAX_PRIORITY_FEE_GWEI=
MAX_FEE_GWEI=

# Newsletter / Mailgun (server-side only)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=mg.tum-blockchain.com
MAILGUN_REGION=eu

# Coffee Chats — Google Drive selfie backup (optional).
# Create a service account in Google Cloud, grant it write access to the
# target Drive folder, and paste its credentials here.
# If any of these are missing the selfie will still be stored in Supabase
# Storage but will not be synced to Drive.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_DRIVE_FOLDER_ID=
